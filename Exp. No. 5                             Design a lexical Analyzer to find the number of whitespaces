#include <stdio.h>
#include <ctype.h>

int main()
{
    char str[100];
    int words = 0;
    int lines = 0;
    int characters = 0;
    int inWord = 0;

    printf("Enter text (use ~ to end):\n");

    scanf("%99[^~]", str);

    for (int i = 0; str[i] != '\0'; i++)
    {
        if (str[i] == '\n')
        {
            lines++;
            inWord = 0;
        }
        else if (str[i] == ' ' || str[i] == '\t')
        {
            inWord = 0;
        }
        else
        {
            characters++;

            if (inWord == 0)
            {
                words++;
                inWord = 1;
            }
        }
    }

    if (characters > 0)
    {
        lines++;
    }

    printf("\nTotal number of words: %d\n", words);
    printf("Total number of lines: %d\n", lines);
    printf("Total number of characters: %d\n", characters);

    return 0;
}
