#include <stdio.h>
#include <string.h>

int main()
{
    char expr[100];
    char lhs;
    int i;

    printf("Enter an expression: ");
    scanf("%s", expr);

    lhs = expr[0];

    printf("\nThree Address Code:\n");

    for (i = 2; expr[i] != '\0'; i++)
    {
        if (expr[i] == '*')
        {
            printf("t1 = %c * %c\n", expr[i - 1], expr[i + 1]);
            printf("t2 = %c + t1\n", expr[2]);
            printf("%c = t2\n", lhs);
            return 0;
        }
    }

    for (i = 2; expr[i] != '\0'; i++)
    {
        if (expr[i] == '+')
        {
            printf("t1 = %c + %c\n", expr[i - 1], expr[i + 1]);
            printf("%c = t1\n", lhs);
            return 0;
        }
    }

    printf("%c = %c\n", lhs, expr[2]);

    return 0;
}
