#include <stdio.h>
#include <string.h>

int main()
{
    char string[50];
    int i;
    int a = 0, b = 0;
    int flag = 1;

    printf("The grammar is:\n");
    printf("S -> aS\n");
    printf("S -> Sb\n");
    printf("S -> ab\n");

    printf("\nEnter the string to be checked:\n");
    scanf("%49s", string);

    /*
     * First character must be 'a'
     */
    if (string[0] != 'a')
    {
        flag = 0;
    }
    else
    {
        /*
         * Count all a's first
         */
        i = 0;

        while (string[i] == 'a')
        {
            a++;
            i++;
        }

        /*
         * After a's, only b's are allowed
         */
        while (string[i] == 'b')
        {
            b++;
            i++;
        }

        /*
         * If any other character exists,
         * string is invalid.
         */
        if (string[i] != '\0')
        {
            flag = 0;
        }

        /*
         * At least one a and one b are required.
         */
        if (a == 0 || b == 0)
        {
            flag = 0;
        }
    }

    if (flag == 1)
    {
        printf("\nString accepted");
    }
    else
    {
        printf("\nString not accepted");
    }

    return 0;
}
