#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char *input;
int i = 0;

char lasthandle[6];
char stack[50];

char handles[][5] = {
    ")E(",
    "E*E",
    "E+E",
    "i",
    "E^E"
};

int top = 0;
int l;

/* Operator precedence table */
char prec[9][9] = {
    /*        +    -    *    /    ^    i    (    )    $ */

    /* + */ {'>', '>', '<', '<', '<', '<', '<', '>', '>'},
    /* - */ {'>', '>', '<', '<', '<', '<', '<', '>', '>'},
    /* * */ {'>', '>', '>', '>', '<', '<', '<', '>', '>'},
    /* / */ {'>', '>', '>', '>', '<', '<', '<', '>', '>'},
    /* ^ */ {'>', '>', '>', '>', '<', '<', '<', '>', '>'},
    /* i */ {'>', '>', '>', '>', '>', 'e', 'e', '>', '>'},
    /* ( */ {'<', '<', '<', '<', '<', '<', '<', '>', 'e'},
    /* ) */ {'>', '>', '>', '>', '>', 'e', 'e', '>', '>'},
    /* $ */ {'<', '<', '<', '<', '<', '<', '<', '<', '>'}
};

/* Return index of terminal */
int getindex(char c)
{
    switch (c)
    {
        case '+':
            return 0;

        case '-':
            return 1;

        case '*':
            return 2;

        case '/':
            return 3;

        case '^':
            return 4;

        case 'i':
            return 5;

        case '(':
            return 6;

        case ')':
            return 7;

        case '$':
            return 8;

        default:
            return -1;
    }
}

/* Shift operation */
void shift()
{
    stack[++top] = input[i++];
    stack[top + 1] = '\0';
}

/* Reduce operation */
int reduce()
{
    int h, len, found, t;

    for (h = 0; h < 5; h++)
    {
        len = strlen(handles[h]);

        if (top + 1 >= len)
        {
            found = 1;

            for (t = 0; t < len; t++)
            {
                if (stack[top - t] != handles[h][t])
                {
                    found = 0;
                    break;
                }
            }

            if (found)
            {
                /*
                 * Replace the handle by E
                 */
                stack[top - len + 1] = 'E';

                top = top - len + 1;

                stack[top + 1] = '\0';

                strcpy(lasthandle, handles[h]);

                return 1;
            }
        }
    }

    return 0;
}

/* Display stack */
void dispstack()
{
    int j;

    for (j = 0; j <= top; j++)
    {
        printf("%c", stack[j]);
    }
}

/* Display remaining input */
void dispinput()
{
    int j;

    for (j = i; j < l; j++)
    {
        printf("%c", input[j]);
    }
}

int main()
{
    input = (char *)malloc(50 * sizeof(char));

    if (input == NULL)
    {
        printf("Memory allocation failed");
        return 1;
    }

    printf("\nEnter the string: ");
    scanf("%49s", input);

    strcat(input, "$");

    l = strlen(input);

    strcpy(stack, "$");
    top = 0;

    printf("\n\nSTACK\t\tINPUT\t\tACTION");

    while (i < l)
    {
        shift();

        printf("\n");
        dispstack();

        printf("\t\t");
        dispinput();

        printf("\t\tShift");

        /*
         * Perform reduction according to
         * operator precedence.
         */
        if (i < l &&
            prec[getindex(stack[top])][getindex(input[i])] == '>')
        {
            while (reduce())
            {
                printf("\n");
                dispstack();

                printf("\t\t");
                dispinput();

                printf("\t\tReduced: E->%s", lasthandle);
            }
        }

        /*
         * Check acceptance
         */
        if (strcmp(stack, "$E") == 0 &&
            input[i] == '$')
        {
            printf("\n\nAccepted");
            free(input);
            return 0;
        }
    }

    /*
     * Final reduction
     */
    while (reduce())
    {
        printf("\n");
        dispstack();

        printf("\t\t");
        dispinput();

        printf("\t\tReduced: E->%s", lasthandle);
    }

    if (strcmp(stack, "$E") == 0)
    {
        printf("\n\nAccepted");
    }
    else
    {
        printf("\n\nNot Accepted");
    }

    free(input);

    return 0;
}
