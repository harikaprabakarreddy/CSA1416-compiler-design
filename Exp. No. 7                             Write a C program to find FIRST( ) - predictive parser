#include <stdio.h>
#include <ctype.h>
#include <string.h>

void FIRST(char[], char);
void addToResultSet(char[], char);

int numOfProductions;
char productionSet[10][10];

int main()
{
    int i;
    char choice;
    char c;
    char result[20];

    printf("How many number of productions? : ");
    scanf("%d", &numOfProductions);

    for (i = 0; i < numOfProductions; i++)
    {
        printf("Enter production Number %d: ", i + 1);
        scanf("%s", productionSet[i]);
    }

    do
    {
        result[0] = '\0';

        printf("\nFind the FIRST of: ");
        scanf(" %c", &c);

        FIRST(result, c);

        printf("\nFIRST(%c) = { ", c);

        for (i = 0; result[i] != '\0'; i++)
        {
            printf("%c ", result[i]);
        }

        printf("}\n");

        printf("Press 'y' to continue: ");
        scanf(" %c", &choice);

    } while (choice == 'y' || choice == 'Y');

    return 0;
}

/*
 * Function FIRST:
 * Computes the elements in FIRST(c)
 * and stores them in Result array.
 */
void FIRST(char Result[], char c)
{
    int i, j, k;
    char subResult[20];
    int foundEpsilon;

    subResult[0] = '\0';
    Result[0] = '\0';

    /*
     * If c is a terminal,
     * FIRST(c) = {c}
     */
    if (!isupper(c))
    {
        addToResultSet(Result, c);
        return;
    }

    /*
     * If c is a non-terminal,
     * search all productions having c
     * on the left-hand side.
     */
    for (i = 0; i < numOfProductions; i++)
    {
        if (productionSet[i][0] == c)
        {
            /*
             * If X -> $
             * add epsilon to FIRST(X).
             */
            if (productionSet[i][2] == '$')
            {
                addToResultSet(Result, '$');
            }
            else
            {
                j = 2;

                /*
                 * Process RHS symbols one by one.
                 */
                while (productionSet[i][j] != '\0')
                {
                    foundEpsilon = 0;

                    FIRST(subResult, productionSet[i][j]);

                    /*
                     * Add FIRST of current symbol
                     * to the result.
                     */
                    for (k = 0; subResult[k] != '\0'; k++)
                    {
                        addToResultSet(Result, subResult[k]);
                    }

                    /*
                     * Check whether epsilon is present.
                     */
                    for (k = 0; subResult[k] != '\0'; k++)
                    {
                        if (subResult[k] == '$')
                        {
                            foundEpsilon = 1;
                            break;
                        }
                    }

                    /*
                     * If epsilon is not found,
                     * stop processing the RHS.
                     */
                    if (!foundEpsilon)
                    {
                        break;
                    }

                    j++;
                }
            }
        }
    }
}

/*
 * Adds an element to the result set
 * without duplicate elements.
 */
void addToResultSet(char Result[], char val)
{
    int k;

    for (k = 0; Result[k] != '\0'; k++)
    {
        if (Result[k] == val)
        {
            return;
        }
    }

    Result[k] = val;
    Result[k + 1] = '\0';
}
